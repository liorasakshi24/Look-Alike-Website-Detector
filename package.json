{
  "name": "phishguard-ai-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PhishGuard AI Express API",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 --test-timeout=180000",
    "test:unit": "node --test --test-concurrency=1 tests/unit.test.js tests/providers.test.js tests/api.test.js",
    "test:sqlite": "node --test --test-concurrency=1 --test-timeout=180000 tests/sqlite.test.js",
    "db:init": "node scripts/init-db.js",
    "registry:check": "node scripts/check-registry.js",
    "provider:check": "node scripts/check-provider.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "tldts": "^6.1.86"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
