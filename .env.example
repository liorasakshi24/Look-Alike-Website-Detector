# --- Runtime ---
NODE_ENV=development
PORT=5000
# Comma-separated origins allowed to call the API with credentials.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
LOG_LEVEL=debug

# --- Database ---
# SQLite file path, resolved relative to server/ unless absolute.
# The file and its parent directory are created automatically; no DB server
# or database username/password is required. Use :memory: only for tests.
DATABASE_PATH=./data/phishguard.sqlite3
SCAN_RETENTION_DAYS=90

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Threat intelligence ---
# auto       -> prefer Web Risk, then Safe Browsing
# webrisk    -> Web Risk only (requires GOOGLE_WEB_RISK_API_KEY)
# safe-browsing -> Safe Browsing v4 only (legacy, non-commercial use)
# none       -> local heuristics only
THREAT_PROVIDER=auto
GOOGLE_WEB_RISK_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
PROVIDER_TIMEOUT_MS=7000

# --- Abuse prevention ---
RATE_LIMIT_ENABLED=true
